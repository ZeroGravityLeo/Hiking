    "@radix-ui/react-switch": "^1.3.8",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
